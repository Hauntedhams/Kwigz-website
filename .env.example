# Copy to .env for local development (git-ignored). `npm run dev` loads it automatically.
# On Render these are set as environment variables instead.
ADMIN_PASSWORD=
# Clay Public API key — enables the admin "Generate leads" tools.
# Create one with `clay api-keys create --name kwigz` (Clay CLI) or in Clay → Settings → Account → API keys.
CLAY_API_KEY=
# Optional, local only: point Clay calls at `npm run fake-clay` instead of the real API.
# CLAY_API_BASE=http://127.0.0.1:4710
# Google AI Studio key (free at https://aistudio.google.com/apikey) — AI banner art in prospect mockups.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional, local only: fake Gemini served by `npm run fake-clay`.
# GEMINI_API_BASE=http://127.0.0.1:4710/v1beta
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:8000
